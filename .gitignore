# Python
# These are distutils/setuptools build-output directories. They are anchored with a
# leading slash so they only match at the repo root -- an unanchored `lib/` also matches
# `src/lib/`, which silently kept the frontend's API client out of git and broke every
# Vercel build with "Can't resolve '@/lib/api'" while still working locally.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/env/
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg
.venv
venv/
ENV/

# Environment variables
.env
.env.local

# Testing & Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Databases & local storage
*.sqlite3
*.db
model_store/

# IDE & OS
.vscode/
.idea/
.DS_Store

.kilo
# ----------------------------
# Frontend / Next.js Ignores
# ----------------------------
# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*
