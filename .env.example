# =====================================================================
# CareFlow Dual-Mode Medical AI — configuration
#
# Copy to .env and fill in. Every value below has a working default in
# careflow/core/config.py; only the API keys are genuinely required.
#   Mode 1: Graph RAG clinical triage (PrimeKG)
#   Mode 2: WHO guidelines vector RAG (Qdrant)
# =====================================================================

# --- Core -----------------------------------------------------------
APP_NAME=CareFlow Dual-Mode Medical AI
APP_ENV=development                 # development | production
DEBUG=true                          # true exposes exception detail in API errors
PORT=8000
HOST=0.0.0.0

# Comma-separated origin allowlist. "*" disables credentialed CORS requests,
# because the Fetch spec forbids wildcard origin + credentials.
# In production set your real origin, e.g. https://careflow.vercel.app
ALLOWED_ORIGINS=*

# --- Vector database (Qdrant) ---------------------------------------
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=who_guidelines
QDRANT_TIMEOUT=10.0
QDRANT_SEARCH_TIMEOUT=3.0

# --- Embeddings ------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_SIZE=1024

# Provider chain:
#   auto   -> hosted endpoint, then local sentence-transformers
#   remote -> hosted endpoint only
#   local  -> local model only (requires the local-embeddings extra)
#   mock   -> deterministic fake vectors; TESTS ONLY
# "mock" is excluded from the auto chain by design: an unreachable embedder must
# fail loudly rather than silently degrade retrieval to random vectors.
EMBEDDING_PROVIDER=auto
EMBEDDING_TIMEOUT=15.0
EMBEDDER_ENDPOINT_URL=https://your-embedder-endpoint.modal.run

# --- LLM providers (at least one required) ---------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Retrieval tuning -------------------------------------------------
RETRIEVAL_TOP_K=5                   # chunks passed to the generator
RETRIEVAL_CANDIDATE_K=20            # wide first pass, fed to the reranker
RERANK_TOP_N=10                     # survivors of reranking
RETRIEVAL_SCORE_THRESHOLD=0.55
TRIAGE_GUIDELINE_TOP_K=3
CITATION_SNIPPET_CHARS=300

# --- Triage session persistence ---------------------------------------
# auto   -> Redis when APP_ENV=production and REDIS_URL is reachable, else in-memory
# redis  -> always Redis. REQUIRED on serverless/multi-replica: consecutive turns
#           are not guaranteed to hit the same process, and in-memory sessions
#           would make every turn start a fresh interview.
# memory -> always in-memory (single process only)
SESSION_BACKEND=auto
SESSION_TTL_SECONDS=3600
SESSION_MAX=1000
REDIS_URL=redis://localhost:6379/0

# --- Knowledge graph ---------------------------------------------------
PRIMEKG_GRAPH_PATH=data/primekg_clinical_graph.pkl

# --- Interview termination engine --------------------------------------
MIN_QUESTIONS=3
MAX_QUESTIONS=8
MIN_SOCRATES_SCORE=5
CONFIDENCE_MARGIN_THRESHOLD=0.40
MAX_ENTROPY_THRESHOLD=1.20
MIN_COVERAGE_THRESHOLD=0.90

# --- Database (optional; in-memory SQLite when unset) -------------------
DATABASE_URL=

# --- Observability (optional) -------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careflow

# --- Web disease-info search (optional) ----------------------------------
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT=10.0
