# =====================================================================
# CareFlow Dual-Mode Medical Chatbot Configuration
# Mode 1: Graph RAG Clinical Triage (PrimeKG)
# Mode 2: WHO Guidelines Dialogue Vector RAG (Qdrant Cloud)
# =====================================================================

# Core Application Settings
APP_NAME=CareFlow Dual-Mode Medical AI
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=*

# Vector Database (Qdrant Cloud) Configuration
QDRANT_URL=https://78e9ff09-6d00-4231-8473-9512b20f2582.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=who_guidelines

# Embedding Model Configuration (BGE-M3 1024d)
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_SIZE=1024

# LLM Providers Configuration
# Primary: Google Gemini (Gemini 3.5 Flash Lite / 3.6 Flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback: Groq (openai/gpt-oss-120b / llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: OpenAI (gpt-4o / gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mode 1: Knowledge Graph & Stopping Engine Parameters
PRIMEKG_GRAPH_PATH=data/primekg_clinical_graph.pkl
MIN_QUESTIONS=3
MAX_QUESTIONS=8
MIN_SOCRATES_SCORE=5
CONFIDENCE_MARGIN_THRESHOLD=0.40
MAX_ENTROPY_THRESHOLD=1.20